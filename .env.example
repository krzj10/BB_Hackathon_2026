# EVA environment contract - version 2.0 (docs/EVA_IMPLEMENTATION_PLAN.md section 2.2)
# Copy to .env for local machine setup. Blank endpoint/model values are
# intentional machine-setup inputs, NOT invented defaults: the backend reports
# them as unconfigured in /api/health and the mandatory provider route refuses
# to serve while they are blank. Never commit a filled-in .env.

EVA_ENV=development
EVA_TIMEZONE=Europe/Warsaw
EVA_DB_URL=sqlite:///./eva.db

# --- Mandatory self-hosted OpenAI-compatible inference ----------------------
# Base URL/model come from the ACTUAL running server (Unsloth Studio over
# Tailscale is primary); never guessed or rewritten. EVA_LLM_ALLOWED_ORIGINS
# is a comma-separated allowlist of configured self-hosted origins for the
# mandatory route (e.g. "https://infer.tailnet.example,https://backup.tailnet.example";
# blank means nothing is allowed). Origins must be scheme+host[:port] only -
# credentials/userinfo, paths, queries and fragments are rejected at load and
# are never echoed back in errors or health output. Cloud endpoints must never
# appear in it.
EVA_LLM_PROVIDER=openai_compatible
EVA_LLM_BASE_URL=
EVA_LLM_MODEL=
EVA_LLM_API_KEY=
EVA_LLM_FALLBACK_BASE_URL=
EVA_LLM_FALLBACK_MODEL=
EVA_LLM_FALLBACK_API_KEY=
EVA_LLM_ALLOWED_ORIGINS=

# --- Optional cloud extension: both permissions default to false ------------
# Never automatic recovery; no cloud key/model/adapter is required at startup.
EVA_ALLOW_CLOUD_INFERENCE=false
EVA_ALLOW_WORKSPACE_CLOUD_INFERENCE=false

# --- Speech to text -----------------------------------------------------------
EVA_STT_PROVIDER=faster-whisper
EVA_WHISPER_MODEL=base
EVA_WHISPER_DEVICE=cpu
EVA_WHISPER_COMPUTE_TYPE=int8
EVA_WAKE_WORD_ENABLED=false

# --- Google OAuth (secrets live outside source control) -----------------------
# Placeholders only - never commit real values. Credentials issued by the
# offline flow are stored under GOOGLE_CREDENTIALS_PATH (default under the
# gitignored secrets/ directory); that file contains refresh/access tokens and
# must never be committed, logged or served.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_CREDENTIALS_PATH=secrets/google_credentials.json
